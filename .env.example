# Environment
ENVIRONMENT=dev

# Postgres
POSTGRES_DATABASE=CROUStillant
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Archive Postgres (base distante pour les vieilles partitions de
# requests_logs — voir CROUStillantData/CROUStillantData/archiver.py).
# En local, ces identifiants pointent vers le service archive-db de
# docker-compose.yml ; en production, vers la vraie base distante.
ARCHIVE_POSTGRES_DATABASE=CROUStillantArchive
ARCHIVE_POSTGRES_USER=
ARCHIVE_POSTGRES_PASSWORD=
ARCHIVE_POSTGRES_HOST=archive-db
ARCHIVE_POSTGRES_PORT=5432

# Discord
WEBHOOK_URL=https://discord.com/api/webhooks/
THUMBNAIL_URL=https://croustillant.menu/logo.png
IMAGE_URL=https://croustillant.menu/banner-small.png
